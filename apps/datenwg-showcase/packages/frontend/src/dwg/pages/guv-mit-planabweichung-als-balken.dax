// Abfragen der Seite „GuV mit Planabweichung als Balken“ ohne Querfilter, zum Prüfen in der DAX-Abfrageansicht.
// erzeugt von `dwg app page`, nicht von Hand ändern.

// Kachel karten (chartkitchen)
EVALUATE
    SUMMARIZECOLUMNS(
        'Kunde'[Kanal],
        'Kunde'[Kanal Sort],
        "actual", 'Fakten'[Umsatz AC],
        "previousYear", 'Fakten'[Umsatz PY bis Ist],
        "plan", 'Fakten'[Umsatz PL bis Ist]
    )
ORDER BY 'Kunde'[Kanal Sort]

// Kachel vorlage (pnl)
EVALUATE
    ADDMISSINGITEMS(
        'Konto'[KontoID],
        'Konto'[Konto],
        'Konto'[L1],
        'Konto'[L2],
        'Konto'[SortOrder],
        'Konto'[RowType],
        'Konto'[FormulaDef],
        'Konto'[SignConvention],
        'Konto'[DisplayInvert],
        'Konto'[VarianceInvert],
        'Konto'[Kommentar],
    SUMMARIZECOLUMNS(
        'Konto'[KontoID],
        'Konto'[Konto],
        'Konto'[L1],
        'Konto'[L2],
        'Konto'[SortOrder],
        'Konto'[RowType],
        'Konto'[FormulaDef],
        'Konto'[SignConvention],
        'Konto'[DisplayInvert],
        'Konto'[VarianceInvert],
        'Konto'[Kommentar],
        "ac", 'Fakten'[GuV AC],
        "pl", 'Fakten'[GuV PL bis Ist]
    ),
        'Konto'[KontoID],
        'Konto'[Konto],
        'Konto'[L1],
        'Konto'[L2],
        'Konto'[SortOrder],
        'Konto'[RowType],
        'Konto'[FormulaDef],
        'Konto'[SignConvention],
        'Konto'[DisplayInvert],
        'Konto'[VarianceInvert],
        'Konto'[Kommentar]
    )
ORDER BY 'Konto'[KontoID], 'Konto'[Konto], 'Konto'[L1], 'Konto'[L2], 'Konto'[SortOrder], 'Konto'[RowType], 'Konto'[FormulaDef], 'Konto'[SignConvention], 'Konto'[DisplayInvert], 'Konto'[VarianceInvert], 'Konto'[Kommentar]

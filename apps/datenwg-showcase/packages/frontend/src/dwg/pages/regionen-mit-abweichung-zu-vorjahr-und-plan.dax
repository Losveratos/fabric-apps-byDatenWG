// Abfragen der Seite „Regionen mit Abweichung zu Vorjahr und Plan“ ohne Querfilter, zum Prüfen in der DAX-Abfrageansicht.
// erzeugt von `dwg app page`, nicht von Hand ändern.

// Kachel karten (chartkitchen)
EVALUATE
    SUMMARIZECOLUMNS(
        'Produkt'[Sorte],
        'Produkt'[Sorte Sort],
        "actual", 'Fakten'[Umsatz AC],
        "previousYear", 'Fakten'[Umsatz PY bis Ist],
        "plan", 'Fakten'[Umsatz PL bis Ist]
    )
ORDER BY 'Produkt'[Sorte Sort]

// Kachel vorlage (pnl)
EVALUATE
    SUMMARIZECOLUMNS(
        'Kunde'[Region],
        'Kalender'[Periode],
        "ac", 'Fakten'[Umsatz AC],
        "py", 'Fakten'[Umsatz PY],
        "pl", 'Fakten'[Umsatz PL]
    )
ORDER BY 'Kunde'[Region], 'Kalender'[Periode]

// Abfragen der Seite „Integrierte Brücke über das Jahr“ ohne Querfilter, zum Prüfen in der DAX-Abfrageansicht.
// erzeugt von `dwg app page`, nicht von Hand ändern.

// Kachel karten (chartkitchen)
EVALUATE
    SUMMARIZECOLUMNS(
        'Produkt'[Sorte],
        'Produkt'[Sorte Sort],
        "actual", 'Fakten'[Umsatz FC],
        "previousYear", 'Fakten'[Umsatz PY],
        "plan", 'Fakten'[Umsatz PL]
    )
ORDER BY 'Produkt'[Sorte Sort]

// Kachel vorlage (chartkitchen)
EVALUATE
    SUMMARIZECOLUMNS(
        'Kalender'[Monatsname],
        'Kalender'[Monat],
        "actual", 'Fakten'[Umsatz AC],
        "previousYear", 'Fakten'[Umsatz PY],
        "forecast", 'Fakten'[Umsatz FC]
    )
ORDER BY 'Kalender'[Monat]

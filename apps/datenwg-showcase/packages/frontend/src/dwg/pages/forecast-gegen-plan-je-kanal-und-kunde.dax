// Abfragen der Seite „Forecast gegen Plan je Kanal und Kunde“ ohne Querfilter, zum Prüfen in der DAX-Abfrageansicht.
// erzeugt von `dwg app page`, nicht von Hand ändern.

// Kachel karten (chartkitchen)
EVALUATE
    SUMMARIZECOLUMNS(
        'Produkt'[Sorte],
        'Produkt'[Sorte Sort],
        "actual", 'Fakten'[Umsatz FC],
        "previousYear", 'Fakten'[Umsatz PY],
        "plan", 'Fakten'[Umsatz PL]
    )
ORDER BY 'Produkt'[Sorte Sort]

// Kachel vorlage (pnl)
EVALUATE
    SUMMARIZECOLUMNS(
        'Kunde'[Kanal],
        'Kunde'[Kunde],
        'Kunde'[Kanal Sort],
        "ac", 'Fakten'[Umsatz AC],
        "pl", 'Fakten'[Umsatz PL],
        "fc", 'Fakten'[Umsatz FC]
    )
ORDER BY 'Kunde'[Kanal Sort], 'Kunde'[Kunde]

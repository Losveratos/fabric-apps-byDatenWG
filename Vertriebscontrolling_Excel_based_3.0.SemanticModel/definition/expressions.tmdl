expression 'Random Values' = ```
		let
		    Source = (Factor as number, //factor to multiply your Data
		  rangestart as number,// Start of the Range for the random Numbers
		  rangeend as number,  // End of the Range for the random Numbers
		  rangedivde as number  // Divdie Number e.g (Range from 95 to 105 / 100 ->> expected value between 0.95 and 1.05)
		 ) => 
		let
		        Source = List.Generate(() =>Factor , each _ > 0, each _ - 1), 
		        // Generates the list for the muliplication of the Data 
		
		        #"Converted to Table" = Table.FromList(Source, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		        #"Changed Type" = Table.TransformColumnTypes(#"Converted to Table",{{"Column1", type number}}),
		        #"Added Custom" = Table.AddColumn(#"Changed Type", "Range", each Number.RandomBetween(rangestart, rangeend)/rangedivde),
		        // generates the new Random number 
		
		        #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Range", type number}}),
		        #"Removed Columns" = Table.RemoveColumns(#"Changed Type1",{"Column1"}),
		       Values = #"Removed Columns"[Range]
		       //generates a list from the Tabel
		    
		    in
		     Values
		in
		    Source
		```
